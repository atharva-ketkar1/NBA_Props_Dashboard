# ML Generated Files & Notebooks
backend/prop_modeling/generated/
# Colab input bundles: ~4MB of code+data archives, reproducible from
# scripts/make_colab_bundle.py, and they would go stale the moment the data syncs.
backend/generated/
# Out-of-fold predictions travel with the bundle so the gate can score the
# model honestly, but they are 4.4MB per retrain and reproducible from the
# trainer. A fresh clone without them makes the gate warn and fall back.
backend/prop_modeling/exported_regression_model/oof_predictions.csv
# Written by the trainer, read by nothing at serve time, and it embeds the
# absolute path of whichever machine trained. model_metadata.json already
# carries the provenance the serve path and the gate actually use.
backend/prop_modeling/exported_regression_model/manifest.json
catboost_info/
backend/prop_modeling/*.ipynb
backend/prop_modeling/*test*.py
# ...but backtest.py is a real module, not a notebook; the glob above is
# aimed at model_test_nb.py.
!backend/prop_modeling/backtest.py

# data archives built by backend/scripts/snapshot.py (never commit: public repo)
nba_dashboard_backup_*.zip
*.zip
vm_logs/

